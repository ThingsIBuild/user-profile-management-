<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>System Info</title>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #0f172a;
      color: #e2e8f0;
    }

    .container {
      padding: 25px;
    }

    h1 {
      margin-bottom: 20px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: #1e293b;
      padding: 20px;
      border-radius: 12px;
    }

    .title {
      color: #94a3b8;
      font-size: 14px;
    }

    .value {
      font-size: 26px;
      font-weight: bold;
    }

    /* PROGRESS BAR */
    .progress {
      height: 8px;
      background: #334155;
      border-radius: 10px;
      margin-top: 10px;
      overflow: hidden;
    }

    .bar {
      height: 8px;
      border-radius: 10px;
      width: 0; /* start from 0 */
      transition: width 1s ease-in-out; /* animation */
    }

    /* COLORS */
    .green { background: #22c55e; }
    .yellow { background: #facc15; }
    .red { background: #ef4444; }

    table {
      width: 100%;
      margin-top: 20px;
      border-collapse: collapse;
    }

    th, td {
      padding: 10px;
      border-bottom: 1px solid #334155;
      font-size: 14px;
    }

    .section {
      margin-top: 30px;
    }

    .back {
      display: inline-block;
      margin-bottom: 20px;
      color: #3b82f6;
      text-decoration: none;
    }
  </style>
</head>

<body>
  <div class="container">

    <a href="/" class="back">← Back</a>

    <h1>🚀 System Information</h1>

    <!-- TOP METRICS -->
    <div class="grid">

      <div class="card">
        <div class="title">Uptime</div>
        <div class="value"><%= data.uptime %></div>
      </div>

      <!-- CPU -->
      <div class="card">
        <div class="title">CPU Usage</div>
        <div class="value"><%= data.cpu.usage %></div>

        <div class="progress">
          <div 
            class="bar <%= parseFloat(data.cpu.usage) > 80 ? 'red' : parseFloat(data.cpu.usage) > 50 ? 'yellow' : 'green' %>"
            data-width="<%= data.cpu.usage %>"
          ></div>
        </div>
      </div>

      <!-- MEMORY -->
      <div class="card">
        <div class="title">Memory</div>
        <div class="value"><%= data.memory.usagePercent %></div>
        <p><%= data.memory.used %> / <%= data.memory.total %></p>

        <div class="progress">
          <div 
            class="bar <%= parseFloat(data.memory.usagePercent) > 85 ? 'red' : parseFloat(data.memory.usagePercent) > 60 ? 'yellow' : 'green' %>"
            data-width="<%= data.memory.usagePercent %>"
          ></div>
        </div>
      </div>

    </div>

    <!-- DISK -->
    <div class="section">
      <h2>💾 Disk Usage</h2>

      <div class="grid">
        <% data.disk.forEach(d => { %>
          <div class="card">
            <div class="title"><%= d.filesystem %></div>
            <div class="value"><%= d.usagePercent %></div>

            <div class="progress">
              <div 
                class="bar <%= parseFloat(d.usagePercent) > 80 ? 'red' : parseFloat(d.usagePercent) > 50 ? 'yellow' : 'green' %>"
                data-width="<%= d.usagePercent %>"
              ></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- CPU TABLE -->
    <div class="section">
      <h2>🔥 CPU Processes</h2>

      <table>
        <tr>
          <th>PID</th>
          <th>Name</th>
          <th>CPU</th>
        </tr>

        <% data.topProcesses.byCPU.forEach(p => { %>
          <tr>
            <td><%= p.pid %></td>
            <td><%= p.name %></td>
            <td><%= p.cpu %></td>
          </tr>
        <% }) %>
      </table>
    </div>

    <!-- MEMORY TABLE -->
    <div class="section">
      <h2>🧠 Memory Processes</h2>

      <table>
        <tr>
          <th>PID</th>
          <th>Name</th>
          <th>Memory</th>
        </tr>

        <% data.topProcesses.byMemory.forEach(p => { %>
          <tr>
            <td><%= p.pid %></td>
            <td><%= p.name %></td>
            <td><%= p.memory %></td>
          </tr>
        <% }) %>
      </table>
    </div>

  </div>

  <!-- 🔥 ANIMATION SCRIPT -->
  <script>
    window.onload = () => {
      const bars = document.querySelectorAll(".bar");

      bars.forEach(bar => {
        const width = bar.getAttribute("data-width");
        
        setTimeout(() => {
          bar.style.width = width;
        }, 200);
      });
    };

    // setInterval(() => {
    //     window.location.reload()
    // },5000)
  </script>

</body>
</html>